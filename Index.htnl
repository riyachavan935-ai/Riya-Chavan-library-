<div class="card">
<div class="card-head"><h3>➕ Add Student - Java Swing Logic - Bada Output</h3><span class="tag tag-pass">OUTPUT</span></div>
<div class="card-body">
<label>Student Full Name *</label><input id="name" placeholder="Ex: Riya Chavan">
<label>Roll Number *</label><input id="roll" placeholder="Ex: 3121">
<label>Marks (0-100) *</label><input id="marks" placeholder="Ex: 92" type="number">
<label>Department</label><select id="dept"><option>Computer Science</option><option>Information Technology</option><option>Mechanical</option><option>Electrical</option><option>Civil</option><option>AI & ML</option></select>
