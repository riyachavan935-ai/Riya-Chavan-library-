<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Management - Java Swing - Riya 3121 - BADA CODE</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f0f9ff}
.header{background:#0c4a6e;color:#fff;padding:20px 30px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
.logo{font-size:24px;font-weight:900}
.hero{background:linear-gradient(135deg,#0c4a6e,#0284c7,#0c4a6e);color:#fff;padding:60px 30px;text-align:center}
.hero h1{font-size:50px;font-weight:900;line-height:1.1}
.hero p{margin-top:15px;font-size:18px;opacity:0.9;max-width:900px;margin-left:auto;margin-right:auto}
.badge{background:#fff;color:#0c4a6e;padding:8px 16px;border-radius:20px;font-size:12px;font-weight:800;margin:5px;display:inline-block}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;padding:0 30px;margin-top:-30px}
.stat{background:#fff;border-radius:16px;padding:20px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.1)}
.stat b{font-size:32px;color:#0c4a6e}
.main{padding:30px;display:grid;grid-template-columns:400px 1fr;gap:20px;max-width:1400px;margin:0 auto}
.card{background:#fff;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,0.08);overflow:hidden;border:1px solid #e0f2fe}
.card-head{background:#0c4a6e;color:#fff;padding:16px 22px;display:flex;justify-content:space-between;align-items:center}
.card-head h3{font-size:14px;font-weight:800}
.card-body{padding:22px}
label{font-size:12px;font-weight:700;color:#334155;margin-top:10px;display:block}
input,select{width:100%;padding:14px;border:2px solid #e0f2fe;border-radius:12px;margin:6px 0 10px;font-size:14px}
input:focus{border-color:#0284c7;outline:none;box-shadow:0 0 0 3px rgba(2,132,199,0.1)}
button{width:100%;padding:14px;border:none;border-radius:12px;font-weight:800;cursor:pointer;font-size:14px;margin-top:8px;transition:0.2s}
button:hover{transform:translateY(-2px)}
.bg1{background:#0c4a6e;color:#fff}
.bg2{background:#16a34a;color:#fff}
.bg3{background:#dc2626;color:#fff}
.bg4{background:#f59e0b;color:#000}
.bg5{background:#1e293b;color:#fff}
.out{background:#020617;color:#4ade80;padding:20px;border-radius:12px;font-family:monospace;font-size:12px;line-height:1.8;min-height:320px;border:2px solid #22c55e;white-space:pre-wrap;margin-top:12px;overflow:auto;max-height:400px}
.books{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.book{border:1px solid #e0f2fe;border-radius:14px;padding:14px;background:#fff}
.book b{font-size:14px}
.book p{font-size:11px;color:#64748b;margin-top:4px}
.tag{font-size:10px;font-weight:800;padding:4px 8px;border-radius:20px}
.tag-pass{background:#dcfce7;color:#166534}
.tag-fail{background:#fee2e2;color:#991b1b}
table{width:100%;border-collapse:collapse;margin-top:14px}
th{background:#0c4a6e;color:#fff;padding:12px;text-align:left;font-size:11px}
td{padding:11px;border-bottom:1px solid #f1f5f9;font-size:12px}
.java{background:#0f172a;color:#facc15;padding:16px;border-radius:12px;font-family:monospace;font-size:11px;line-height:1.7;margin-top:12px}
.footer{background:#020617;color:#94a3b8;text-align:center;padding:30px;font-size:12px;margin-top:30px}
@media(max-width:1000px){.stats{grid-template-columns:repeat(2,1fr)}.main{grid-template-columns:1fr}.hero h1{font-size:32px}}
</style>
</head>
<body>
<div class="header"><div class="logo">🎓 StudentVerse - Java Swing Project</div><div style="font-size:13px;font-weight:700">Riya Chavan - 3121 | BADA CODE</div></div>
